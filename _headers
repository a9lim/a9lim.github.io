# Security headers (all pages)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; base-uri 'self'; frame-ancestors 'self'
  Content-Language: en

# Cross-origin isolation for geon (enables SharedArrayBuffer / high-res timers for WebGPU)
/geon/*
  Cross-Origin-Embedder-Policy: credentialless

# HTML — no-cache with stale-while-revalidate (static pages only;
# Worker-served SPA routes set their own cache headers)
/*.html
  Cache-Control: public, max-age=0, stale-while-revalidate=86400
/
  Cache-Control: public, max-age=0, stale-while-revalidate=86400

