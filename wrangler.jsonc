{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a9lim",
  "main": "_worker.js",
  "compatibility_date": "2026-04-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "drop-trailing-slash"
  },
  "analytics_engine_datasets": [
    { "binding": "VIEWS", "dataset": "a9lim_views" }
  ]
}
