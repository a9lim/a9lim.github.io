{
  "name": "a9lim-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:stage": "node tools/stage-assets.mjs",
    "build:content": "node tools/build.mjs",
    "build": "npm run build:stage && npm run build:content",
    "check": "npm run build && node tools/build.mjs --check && node tests/content-pipeline/run.mjs && node tests/deploy-layout/run.mjs",
    "test": "npm run check && node --test features/surveys/tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260722.1": true
  }
}
