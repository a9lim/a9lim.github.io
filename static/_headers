/resume.pdf
  Content-Type: application/pdf
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, immutable

# Paper PDF accompanying /blog/quadratic-refinements-in-games. Listed
# explicitly rather than as /*.pdf: matching rules all apply in order, and a
# glob here would override the resume's own cache policy above.
