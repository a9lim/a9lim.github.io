# Public asset names are stable, so browsers revalidate them on every use via
# the global Cache-Control rule. The edge cache below is isolated per deploy.
# Shared design system
/shared/*
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, immutable

# One-cycle compatibility aliases for the former root-level URLs.
/shared-*.js
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, immutable
/shared-*.css
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, immutable

